CREATE SCHEMA firebase;
CREATE TABLE "firebase"."notes" (
  "id" text NOT NULL,
  "data" jsonb NOT NULL,
  "views" bigint,
  PRIMARY KEY ("id")
);
CREATE TABLE "firebase"."users" (
  "id" text NOT NULL,
  "data" jsonb NOT NULL,
  "active" boolean,
  "joined" timestamptz,
  "name" text,
  "nick" text,
  "score" double precision,
  PRIMARY KEY ("id")
);
CREATE TABLE "firebase"."users__orders" (
  "parent_path" text NOT NULL,
  "parent_id" text NOT NULL,
  "id" text NOT NULL,
  "data" jsonb NOT NULL,
  "total" bigint,
  PRIMARY KEY ("parent_path", "id")
);
