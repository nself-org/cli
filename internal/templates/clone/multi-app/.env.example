# multi-app isolation reference: copy these lines into .env.local, then run `nself build`.
PROJECT_NAME=my-multi-app
BASE_DOMAIN=localhost
# hasura-auth turns the user's metadata.source_account_id (set at signup) into the
# x-hasura-source-account-id claim that every permission filter compares against.
AUTH_JWT_CUSTOM_CLAIMS={"source-account-id":"metadata.source_account_id"}
