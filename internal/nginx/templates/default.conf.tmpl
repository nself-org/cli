# Generated by nself build - DO NOT EDIT MANUALLY
# HTTP -> HTTPS redirect and health endpoint

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    server_tokens off;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        try_files $uri =404;
    }

    location /health {
        access_log off;
        return 200 'OK';
        add_header Content-Type text/plain;
    }

    location / {
{{- if .HasSSL}}
        return 301 https://$host$request_uri;
{{- else}}
        return 200 'OK';
        add_header Content-Type text/plain;
{{- end}}
    }
}
{{if .HasSSL}}
server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    http2 on;
    server_name _;
    server_tokens off;

    ssl_certificate {{.SSLBasePath}}/certificates/{{.SSLDir}}/fullchain.pem;
    ssl_certificate_key {{.SSLBasePath}}/certificates/{{.SSLDir}}/privkey.pem;

    location /health {
        access_log off;
        return 200 'OK';
        add_header Content-Type text/plain;
    }

    location / {
        return 444;
    }
}
{{end}}
