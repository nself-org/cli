# Generated by nself build - DO NOT EDIT MANUALLY
# Service: {{.Route}}.{{.BaseDomain}}
#
# Every proxy target below is resolved at REQUEST time via the Docker
# embedded DNS resolver (127.0.0.11, see nginx.conf.tmpl), never via a
# static `upstream {}` block. A static upstream block is fine only until
# the target container is recreated (nself restart, OOM, `docker system
# prune`, a rebuild) — the new container gets a new IP on the Docker
# bridge network, and nginx keeps proxying to the old one until a manual
# `nginx -s reload`, 502ing every request in between. This bit staging
# for auth.task.staging.nself.org on 2026-09-03 (ntask_auth recreated,
# nself-web's nginx kept the stale IP). Every service route, core or
# optional, must use the dynamic pattern below — there is no service in
# this generator whose container is guaranteed to never be recreated.

server {
{{- if .HasSSL}}
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
{{- else}}
    listen 80;
    listen [::]:80;
{{- end}}
    server_name {{.Route}}.{{.BaseDomain}};
{{if .HasSSL}}
    ssl_certificate {{.SSLBasePath}}/certificates/{{.SSLDir}}/fullchain.pem;
    ssl_certificate_key {{.SSLBasePath}}/certificates/{{.SSLDir}}/privkey.pem;
{{- if .HasTrustedChain}}
    ssl_trusted_certificate {{.SSLBasePath}}/certificates/{{.SSLDir}}/chain.pem;
    ssl_stapling on;
    ssl_stapling_verify on;
{{- end}}
{{end}}
    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "0" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'" always;
{{- if .HasSSL}}
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
{{- end}}
    server_tokens off;
    proxy_hide_header X-Powered-By;
    proxy_hide_header Server;

    # Block access to sensitive files and directories
    location ~ /\.(env|git|svn|htaccess|htpasswd|dockerignore) {
        return 404;
    }
    location ~ ^/(docker-compose|Dockerfile) {
        return 404;
    }

    location = /healthz {
        set $healthz_up {{.ProxyTarget}};
        proxy_pass $healthz_up;
        proxy_method GET;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    {{- range .PathZones}}
    # SEC-HARDENING-06: path-scoped rate limit, stricter than the
    # server-wide zone below. nginx matches the longest prefix location
    # regardless of file order, so this always wins over `location /` for
    # this path.
    location {{if .Exact}}= {{end}}{{.Path}} {
        limit_req zone={{.Zone}} burst={{.Burst}} nodelay;
        # Same request-time resolution as the catch-all `location /` below
        # (see its comment) — this path-scoped block proxies to the exact
        # same target, just under a stricter zone.
        set $up_{{$.UpstreamName}} {{$.ProxyTarget}};
        proxy_pass $up_{{$.UpstreamName}};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_pass_request_headers on;
    }
    {{- end}}

    location / {
        {{- if .RateZone}}
        limit_req zone={{.RateZone}} burst={{.Burst}} nodelay;
        {{- end}}
        {{- if .ConnLimit}}
        limit_conn conn_limit_per_ip {{.ConnLimit}};
        {{- end}}
        # Re-resolve per request via the Docker embedded resolver (127.0.0.11,
        # see nginx.conf.tmpl) instead of a static `upstream {}` block. A
        # variable in proxy_pass forces nginx to look up {{.Upstream}} at
        # request time, so a container recreate (new IP) is picked up within
        # the resolver's valid=10s TTL instead of 502ing until a manual
        # `nginx -s reload`.
        set $up_{{.UpstreamName}} {{.ProxyTarget}};
        proxy_pass $up_{{.UpstreamName}};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_pass_request_headers on;
        {{- if .WebSocket}}
        proxy_read_timeout 86400;
        {{- end}}
    }
}
