# Service: api.example.com
#
# Every proxy target below is resolved at REQUEST time via the Docker
# embedded DNS resolver (127.0.0.11, see nginx.conf.tmpl), never via a
# static `upstream {}` block. A static upstream block is fine only until
# the target container is recreated (nself restart, OOM, `docker system
# prune`, a rebuild) — the new container gets a new IP on the Docker
# bridge network, and nginx keeps proxying to the old one until a manual
# `nginx -s reload`, 502ing every request in between. This bit staging
# for auth.task.staging.nself.org on 2026-09-03 (ntask_auth recreated,
# nself-web's nginx kept the stale IP). Every service route, core or
# optional, must use the dynamic pattern below — there is no service in
# this generator whose container is guaranteed to never be recreated.

server {
