{
  "unmodelled_global": [],
  "routes": [
    {
      "id": "plugin:backup/backup.conf#1",
      "source": "plugin",
      "owner": "backup",
      "file": "nginx/sites/backup-backup.conf",
      "server_names": [
        "backup.example.test"
      ],
      "listen": {
        "http": false,
        "https": true
      },
      "tls": {
        "ssl_dir": "example-test",
        "has_trusted_chain": false,
        "protocols": [],
        "ciphers": null
      },
      "http_to_https_redirect": false,
      "security_headers": {},
      "blocked_paths": [],
      "rate_limit": null,
      "locations": [
        {
          "path": "/",
          "match": "prefix",
          "upstream": {
            "scheme": "http",
            "host": "backup",
            "port": 3050
          },
          "rate_limit": null,
          "websocket": false,
          "forwarded_headers": true,
          "headers_set": {},
          "timeouts": {
            "connect_s": null,
            "read_s": null,
            "send_s": null
          },
          "max_body_bytes": null,
          "access_log": true,
          "deny_all": false,
          "methods": null,
          "return": null,
          "static_root": null,
          "health_probe": false
        }
      ],
      "shadowed_by": null,
      "unmodelled": []
    }
  ]
}
