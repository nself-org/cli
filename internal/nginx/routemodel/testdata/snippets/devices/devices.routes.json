{
  "unmodelled_global": [],
  "routes": [
    {
      "id": "plugin:devices/devices.conf#1",
      "source": "plugin",
      "owner": "devices",
      "file": "nginx/sites/devices-devices.conf",
      "server_names": [
        "devices.example.test"
      ],
      "listen": {
        "http": false,
        "https": true
      },
      "tls": {
        "ssl_dir": "",
        "has_trusted_chain": false,
        "protocols": [],
        "ciphers": null
      },
      "http_to_https_redirect": false,
      "security_headers": {},
      "blocked_paths": [],
      "rate_limit": null,
      "locations": [
        {
          "path": "/",
          "match": "prefix",
          "upstream": {
            "scheme": "http",
            "host": "127.0.0.1",
            "port": 3603
          },
          "rate_limit": null,
          "websocket": false,
          "forwarded_headers": true,
          "headers_set": {
            "Connection": ""
          },
          "timeouts": {
            "connect_s": null,
            "read_s": 60,
            "send_s": null
          },
          "max_body_bytes": 10485760,
          "access_log": true,
          "deny_all": false,
          "methods": null,
          "return": null,
          "static_root": null,
          "health_probe": false
        }
      ],
      "shadowed_by": null,
      "unmodelled": [
        "ssl_certificate /etc/nginx/certs/example.test/fullchain.pem;",
        "ssl_certificate_key /etc/nginx/certs/example.test/privkey.pem;"
      ]
    }
  ]
}
