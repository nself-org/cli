{
  "unmodelled_global": [
    "upstream rom_discovery { server 127.0.0.1:3125; keepalive 32; }"
  ],
  "routes": [
    {
      "id": "plugin:rom-discovery/rom-discovery.conf#1",
      "source": "plugin",
      "owner": "rom-discovery",
      "file": "nginx/sites/rom-discovery-rom-discovery.conf",
      "server_names": [
        "rom-discovery.localhost"
      ],
      "listen": {
        "http": true,
        "https": false
      },
      "tls": null,
      "http_to_https_redirect": false,
      "security_headers": {},
      "blocked_paths": [],
      "rate_limit": null,
      "locations": [
        {
          "path": "/",
          "match": "prefix",
          "upstream": {
            "scheme": "http",
            "host": "127.0.0.1",
            "port": 3125
          },
          "rate_limit": null,
          "websocket": false,
          "forwarded_headers": true,
          "headers_set": {
            "Connection": ""
          },
          "timeouts": {
            "connect_s": 10,
            "read_s": 60,
            "send_s": null
          },
          "max_body_bytes": null,
          "access_log": true,
          "deny_all": false,
          "methods": null,
          "return": null,
          "static_root": null,
          "health_probe": false
        }
      ],
      "shadowed_by": null,
      "unmodelled": []
    }
  ]
}
