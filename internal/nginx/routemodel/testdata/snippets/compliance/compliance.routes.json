{
  "unmodelled_global": [
    "upstream compliance_backend { server 127.0.0.1:3211; keepalive 32; }"
  ],
  "routes": [
    {
      "id": "plugin:compliance/compliance.conf#1",
      "source": "plugin",
      "owner": "compliance",
      "file": "nginx/sites/compliance-compliance.conf",
      "server_names": [
        "compliance.example.test"
      ],
      "listen": {
        "http": true,
        "https": false
      },
      "tls": null,
      "http_to_https_redirect": true,
      "security_headers": {},
      "blocked_paths": [],
      "rate_limit": null,
      "locations": [
        {
          "path": "/",
          "match": "prefix",
          "upstream": null,
          "rate_limit": null,
          "websocket": false,
          "forwarded_headers": false,
          "headers_set": {},
          "timeouts": {
            "connect_s": null,
            "read_s": null,
            "send_s": null
          },
          "max_body_bytes": null,
          "access_log": true,
          "deny_all": false,
          "methods": null,
          "return": {
            "status": 301,
            "to": "https://$host$request_uri"
          },
          "static_root": null,
          "health_probe": false
        }
      ],
      "shadowed_by": null,
      "unmodelled": []
    },
    {
      "id": "plugin:compliance/compliance.conf#2",
      "source": "plugin",
      "owner": "compliance",
      "file": "nginx/sites/compliance-compliance.conf",
      "server_names": [
        "compliance.example.test"
      ],
      "listen": {
        "http": false,
        "https": true
      },
      "tls": {
        "ssl_dir": "example.test",
        "has_trusted_chain": false,
        "protocols": [
          "TLSv1.2",
          "TLSv1.3"
        ],
        "ciphers": "HIGH:!aNULL:!MD5"
      },
      "http_to_https_redirect": false,
      "security_headers": {},
      "blocked_paths": [],
      "rate_limit": null,
      "locations": [
        {
          "path": "/",
          "match": "prefix",
          "upstream": {
            "scheme": "http",
            "host": "127.0.0.1",
            "port": 3211
          },
          "rate_limit": null,
          "websocket": false,
          "forwarded_headers": true,
          "headers_set": {
            "Connection": ""
          },
          "timeouts": {
            "connect_s": null,
            "read_s": 60,
            "send_s": 60
          },
          "max_body_bytes": 10485760,
          "access_log": true,
          "deny_all": false,
          "methods": null,
          "return": null,
          "static_root": null,
          "health_probe": false
        },
        {
          "path": "/health",
          "match": "prefix",
          "upstream": {
            "scheme": "http",
            "host": "127.0.0.1",
            "port": 3211
          },
          "rate_limit": null,
          "websocket": false,
          "forwarded_headers": false,
          "headers_set": {},
          "timeouts": {
            "connect_s": null,
            "read_s": null,
            "send_s": null
          },
          "max_body_bytes": 10485760,
          "access_log": false,
          "deny_all": false,
          "methods": null,
          "return": null,
          "static_root": null,
          "health_probe": false
        }
      ],
      "shadowed_by": null,
      "unmodelled": [
        "proxy_pass http://compliance_backend/health;",
        "proxy_set_header Host $host;"
      ]
    }
  ]
}
