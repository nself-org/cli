PROJECT_NAME=proxy-full
ENV=dev
BASE_DOMAIN=example.test
SSL_MODE=none
MINIO_ENABLED=true
ADMIN_ENABLED=true
SEARCH_ENABLED=true
MAILPIT_ENABLED=true
FUNCTIONS_ENABLED=true
CS_1=worker-one:express-ts
CS_1_PORT=9011
CS_1_ROUTE=worker-one
CS_2=worker-two:express-ts
CS_2_PORT=9012
CS_2_ROUTE=worker-two
FRONTEND_APP_1_DISPLAY_NAME=web
FRONTEND_APP_1_SYSTEM_NAME=web
FRONTEND_APP_1_PORT=3000
FRONTEND_APP_1_ROUTE=web
INTERNAL_ROUTE_1_NAME=internal-one
INTERNAL_ROUTE_1_SUBDOMAIN=internal-one
INTERNAL_ROUTE_1_TARGET=http://worker-one:9011
INTERNAL_ROUTE_2_NAME=internal-two
INTERNAL_ROUTE_2_SUBDOMAIN=internal-two
INTERNAL_ROUTE_2_TARGET=https://worker-two:9012
INTERNAL_ROUTE_2_WEBSOCKET=true
