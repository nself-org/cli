# Line endings. Without this, a Windows checkout converts every text file to
# CRLF, which makes `gofmt -l` report the whole tree as unformatted and makes
# byte-comparison of generated artifacts fail. The repo's canonical form is LF
# everywhere; Go tooling emits LF on every platform.
* text=auto eol=lf
*.go text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.txt text eol=lf

# nSelf standard .gitattributes
# LFS prevention rules - these file types should only exist in GitHub Releases,
# never tracked in git history. Added to prevent accidental tracking of binaries.
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.gif filter=lfs diff=lfs merge=lfs -text
*.tar.gz filter=lfs diff=lfs merge=lfs -text
*.tar.bz2 filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
*.gz filter=lfs diff=lfs merge=lfs -text
*.deb filter=lfs diff=lfs merge=lfs -text
*.rpm filter=lfs diff=lfs merge=lfs -text
*.exe filter=lfs diff=lfs merge=lfs -text
*.dmg filter=lfs diff=lfs merge=lfs -text
*.apk filter=lfs diff=lfs merge=lfs -text
*.ipa filter=lfs diff=lfs merge=lfs -text

# Small signed-archive fixtures stay plain files: the verifier tests read their bytes.
internal/plugin/verify/signature/testdata/** -filter -diff -merge -text
