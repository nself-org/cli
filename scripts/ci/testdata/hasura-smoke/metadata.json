{
  "version": 3,
  "sources": [
    {
      "name": "default",
      "kind": "postgres",
      "configuration": {
        "connection_info": {
          "database_url": { "from_env": "HASURA_GRAPHQL_DATABASE_URL" },
          "use_prepared_statements": true,
          "isolation_level": "read-committed"
        }
      },
      "tables": [
        {
          "table": { "schema": "public", "name": "smoke_items" },
          "array_relationships": [
            {
              "name": "tags",
              "using": {
                "foreign_key_constraint_on": {
                  "column": "item_id",
                  "table": { "schema": "public", "name": "smoke_tags" }
                }
              }
            }
          ],
          "select_permissions": [
            {
              "role": "user",
              "permission": { "columns": ["id", "name", "created_at"], "filter": {} }
            }
          ],
          "event_triggers": [
            {
              "name": "smoke_item_events",
              "definition": {
                "enable_manual": false,
                "insert": { "columns": "*" }
              },
              "retry_conf": { "num_retries": 3, "interval_sec": 2, "timeout_sec": 30 },
              "webhook": "http://receiver:9100/hook"
            }
          ]
        },
        {
          "table": { "schema": "public", "name": "smoke_tags" },
          "select_permissions": [
            {
              "role": "user",
              "permission": { "columns": ["id", "item_id", "tag"], "filter": {} }
            }
          ]
        }
      ]
    }
  ],
  "remote_schemas": [
    {
      "name": "smoke_remote",
      "definition": { "url": "http://receiver:9101/graphql", "timeout_seconds": 20 }
    }
  ]
}
