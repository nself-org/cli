ENV=dev
PROJECT_NAME=proxy-swap-a
BASE_DOMAIN=proxy.test
SSL_MODE=local
HASURA_ROUTE=hasura
AUTH_ENABLED=true
STORAGE_ENABLED=true
MINIO_ENABLED=true
MINIO_ROOT_USER=fixture-fake-admin
MINIO_ROOT_PASSWORD=fixture-fake-password-0123456789
# API_DOCS_* variables are not parsed (D-0435); docs keep their enabled default.
CS_1=whoami:express-ts:8001:whoami
CS_1_COMMAND=--port=8001
CS_1_HEALTHCHECK=disabled
CS_1_IMAGE=traefik/whoami:v1.11.0@sha256:200689790a0a0ea48ca45992e0450bc26ccab5307375b41c84dfc4f2475937ab
CS_2=websocket:express-ts:8090
CS_2_ENV=PORT=8090
CS_2_IMAGE=jmalloc/echo-server:v0.3.7@sha256:c87f80de8dbb976a59b228fc9ecf257e0574c6f760c2f1c5f05f64c7ac7fbc1e
CS_2_HEALTHCHECK=disabled
# Custom routes do not model websocket upgrades; expose CS_2 through this route.
INTERNAL_ROUTE_1_NAME=websocket
INTERNAL_ROUTE_1_SUBDOMAIN=websocket
INTERNAL_ROUTE_1_TARGET=http://websocket:8090
INTERNAL_ROUTE_1_WEBSOCKET=true
