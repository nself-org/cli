#!/usr/bin/env bash
# Test stub for `curl`: logs argv; Docker Hub answers from fixtures once the matching
# publish workflow was dispatched; release downloads 404 (exit 22, as curl -f does).
printf '%s\n' "$*" >> "$CURL_LOG"
url=""; for a in "$@"; do url=$a; done
r=""
case "$url" in
  https://hub.docker.com/v2/repositories/nself/nself/tags/*) r=cli ;;
  https://hub.docker.com/v2/repositories/nself/nself-admin/tags/*) r=admin ;;
  */releases/download/*) exit 22 ;;
  */archive/refs/tags/*) printf 'fixture source archive' ;;
  *) exit 22 ;;
esac
if [ -n "$r" ]; then
  # An in-flight publish makes the image appear on the third lookup.
  if [ -f "$ST/inflight@$r" ]; then
    c=$(cat "$ST/hubcalls@$r" 2>/dev/null || echo 0); echo $((c + 1)) > "$ST/hubcalls@$r"
    [ "$c" -ge 2 ] && { cat "$FIXTURES/hub-tag.json"; exit 0; }
  fi
  [ -f "$ST/dispatch/docker-publish.yml@$r" ] && { cat "$FIXTURES/hub-tag.json"; exit 0; }
  exit 22
fi
