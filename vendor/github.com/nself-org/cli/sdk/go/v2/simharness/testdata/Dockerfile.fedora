FROM fedora:41@sha256:f1a3fab47bcb3c3ddf3135d5ee7ba8b7b25f2e809a47440936212a3a50957f3d
RUN dnf install -y --setopt=install_weak_deps=False openssh-server iproute iproute-tc shadow-utils \
 && dnf clean all \
 && useradd -m -s /bin/bash nself \
 && usermod -p '*' nself
COPY entrypoint.sh /entrypoint.sh
RUN chmod 755 /entrypoint.sh
EXPOSE 22
ENTRYPOINT ["/entrypoint.sh"]
