{
  "name": "@nself/sdk",
  "version": "1.4.5",
  "description": "TypeScript consumer SDK for nSelf \u2014 query GraphQL, manage plugins, auth, and admin from any TS/JS app.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nself-org/cli.git",
    "directory": "sdk/ts-sdk"
  },
  "keywords": [
    "nself",
    "sdk",
    "graphql",
    "self-hosted"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "@types/node": "^20.12.12",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.12",
    "ts-jest": "^29.2.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ]
  },
  "pnpm": {
    "overrides": {
      "browserslist": ">=4.28.7 <5.0.0",
      "js-yaml": ">=3.15.1 <4.0.0",
      "brace-expansion": ">=1.1.16 <2.0.0"
    }
  }
}
