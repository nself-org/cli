{
  "name": "@nself/cli-api",
  "version": "1.4.15",
  "description": "Typed TypeScript client for the nSelf CLI control API (nself admin serve), generated from the OpenAPI contract.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nself-org/cli.git",
    "directory": "sdk/ts-cli-api"
  },
  "keywords": [
    "nself",
    "cli",
    "api",
    "openapi",
    "self-hosted"
  ],
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.12",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.4.5"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ]
  },
  "pnpm": {
    "overrides": {
      "browserslist": ">=4.28.7 <5.0.0",
      "js-yaml": ">=3.15.1 <4.0.0",
      "brace-expansion": ">=1.1.21 <2.0.0",
      "handlebars@<4.7.10": ">=4.7.10 <5.0.0"
    }
  }
}
