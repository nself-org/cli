{
  "name": "@nself/plugin-sdk",
  "version": "1.4.3",
  "description": "TypeScript/Node.js plugin authoring SDK for nSelf",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test"
  },
  "files": [
    "dist",
    "templates"
  ],
  "dependencies": {
    "express": "^4.18.3",
    "pino": "^9.1.0",
    "yaml": "^2.4.1"
  },
  "peerDependencies": {
    "pg": "^8.11.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^25.8.0",
    "@types/pg": "^8.11.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "eslint": "^10.4.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^6.0.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/*.test.ts"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.test.json"
        }
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nself-org/cli.git",
    "directory": "sdk/ts"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "browserslist": ">=4.28.7 <5.0.0",
    "js-yaml": ">=3.15.1 <4.0.0",
    "brace-expansion@<1.1.16": ">=1.1.16 <2.0.0",
    "brace-expansion@>=5.0.0 <5.0.7": ">=5.0.7 <6.0.0"
  }
}
