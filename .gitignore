# OS / editor junk (additions per Clean Working Tree rule)
Thumbs.db
*.swo
*~

# Build artifacts (additions per Clean Working Tree rule)
coverage.txt

# Binary
/nself
/nself.exe
nself-darwin-*
nself-linux-*
nself-windows-*

# Compiled helpers from tools/ land at the repo root when built with a bare
# `go build ./tools/<name>`. They are large (flagaudit is ~38 MB) and the root
# allowlist in .github/workflows/clean-root.yml does not permit them, so an
# accidental `git add .` would both fail CI and push a binary to a public repo.
/flagaudit
/flagaudit.exe

# bin/ holds locally built binaries (CI builds its own into bin/ at run time).
# Constitution section 2.6: no compiled binaries in Git; TestTrackedBinaries enforces it.
/bin/

# Go build
*.test
*.out

# nSelf project files (if someone runs nself in this dir by mistake)
docker-compose.yml
.env
.env.*
!.env.example
# Test fixtures: .env is intentionally NOT tracked (kept as .env.example instead).
# Regenerated at test runtime by copyDirForTest from the .env.example counterpart.
internal/migration/testdata/v0.9-fixture/.env
/nginx/
/ssl/
/postgres/
/monitoring/
services/
.nself/
backups/

# IDE
.idea/
.vscode/
*.swp
.DS_Store

# Distribution artifacts
dist/
*.tar.gz
*.tar.gz.bak
*.tar.bz2
.releases/

# Claude working memory
.claude/temp/

# Test coverage
coverage.out
coverage.html

# nSelf
.env.local
.env.*.local
.env.secrets
.volumes/
logs/
*.log
node_modules/
.vscode/*
.claude/
.codex/
.ai/
.cursor/
.aider/
.aider.chat.history.md
.continue/
.windsurf/
.gemini/
.codeium/

# Vercel CLI artifacts (accidental link — cli is Go binary, not a Vercel project)
.vercel/

# TLS/SSL cert and key files — never track private keys
*.key
*.pem
bin/certs/
!src/templates/certs/**/*.key
!src/templates/certs/**/*.pem

# Binary exclusions (Mega P1 T-E3-03 hardening)
*.exe
*.dll
*.so
*.dylib
endpoint-auth-checker
# Explicitly block Vercel OIDC token lines (P2-E2-W2-S3-T13d)
VERCEL_OIDC_TOKEN=*

# Generated Files & Secret Safety (P6-E11-W2-S2-T13) -- PPI hard rule
backend/docker-compose.yml
backend/docker-compose.override.yml
*.generated.env
**/*.gen.yml
