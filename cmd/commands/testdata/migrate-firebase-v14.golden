-- Firebase Auth user import
-- Source: ../../test/fixtures/import/firebase/auth-export.json
-- Users: 3
-- Review carefully; passwords are NOT migrated (users must reset).

BEGIN;

INSERT INTO auth.users (id, email, email_confirmed_at, raw_user_meta_data, created_at, is_sso_user)
VALUES (gen_random_uuid(), 'ann@example.test', NOW(), '{"display_name":"Ann Example","firebase_uid":"fbuid-ann-0001"}'::jsonb, NOW(), false)
ON CONFLICT (email) DO NOTHING;

INSERT INTO auth.users (id, email, email_confirmed_at, raw_user_meta_data, created_at, is_sso_user)
VALUES (gen_random_uuid(), 'bob@example.test', NULL, '{"display_name":"Bob Example","firebase_uid":"fbuid-bob-0002"}'::jsonb, NOW(), false)
ON CONFLICT (email) DO NOTHING;

INSERT INTO auth.users (id, email, email_confirmed_at, raw_user_meta_data, created_at, is_sso_user)
VALUES (gen_random_uuid(), 'cy@example.test', NOW(), '{"display_name":"","firebase_uid":"fbuid-cy-0003"}'::jsonb, NOW(), false)
ON CONFLICT (email) DO NOTHING;

COMMIT;

