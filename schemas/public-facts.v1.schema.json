{
  "$comment": "GENERATED BY tools/schemagen — DO NOT HAND EDIT",
  "$id": "urn:nself:cli:schema:public-facts:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Public facts (contract cli.public-facts v1): version, verbs and counts projected from .github/VERSION and the committed command registry. Generated by tools/facts.",
  "properties": {
    "_generated": {
      "const": "GENERATED BY tools/facts — DO NOT HAND EDIT",
      "type": "string"
    },
    "contract_mode": {
      "const": "v1.5",
      "type": "string"
    },
    "counts": {
      "additionalProperties": false,
      "properties": {
        "commands": {
          "type": "integer"
        },
        "core": {
          "type": "integer"
        },
        "core_missing": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "top_level": {
          "type": "integer"
        }
      },
      "required": [
        "commands",
        "core",
        "core_missing",
        "top_level"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": "1",
      "type": "string"
    },
    "sources": {
      "additionalProperties": false,
      "properties": {
        "openapi_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": [
            "string",
            "null"
          ]
        },
        "registry_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "openapi_sha256",
        "registry_sha256"
      ],
      "type": "object"
    },
    "verbs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z.-]+)?$",
      "type": "string"
    }
  },
  "required": [
    "_generated",
    "contract_mode",
    "counts",
    "schema_version",
    "sources",
    "verbs",
    "version"
  ],
  "type": "object"
}
